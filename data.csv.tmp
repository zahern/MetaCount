PAPER_CONFIG = {,0
    "K_range": (2, 10),          # Full SA search,0
    "K_quick": (2, 5),           # Quick mode,0
    "min_obs_cluster": 400,       # lowered from 800 to allow K>6,0
    "n_cv_folds": 5,,0
    "n_bootstrap": 200,,0
    "n_pi_boot": 500,,0
    "n_permute": 50,,0
    "sa_temp": 10.0,,0
    "sa_alpha": 0.97,,0
    "sa_neighbors": 3,           # Reduced for pipeline speed,0
    "sa_temp_min": 1e-10,,0
    "n_changes": 80,,0
    "level_of_sig": 0.05,,0
    "max_vif": 10.0,,0
    # Joint temporal-error-structure search (reviewer: simultaneous,0
    # optimisation over temporal error structure). e_k per cluster is a,0
    # decision variable solved inside the SA loop (see zeke_temporal_search).,0
    "temporal_search": True,       # False = legacy IID-only SA objective,0
    "temporal_flip_prob": 0.15,    # P(mutate one cluster's e_k per neighbour),0
    "temporal_candidates": [0, 1, 2, 3],  # IID, AR(1), RW-drift, NUR,0
},0
,0
