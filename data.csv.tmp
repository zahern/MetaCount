                val = coeffs.get("Intercept", 0.0),0
                for vi, vname in enumerate(all_var_names):,0
                    raw = float(row.iloc[psi_col + 1 + vi]),0
                    beta = coeffs.get(vname, 0.0),0
                    if beta != 0 and raw > 0:,0
                        val += beta * log(raw),0
                ols_pred.append(val),0
            ax.plot(time_pts, ols_pred, "b--", lw=1.5, alpha=0.7, label="OLS (i.i.d.)"),0
