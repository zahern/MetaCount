                f"RMSE={met['RMSE']:.3f}\nNRMSE={met['NRMSE']:.3f}\nMAPE={met['MAPE']:.1f}%\n$R^2$={r2_plot:.3f}",,0
                transform=ax.transAxes, fontsize=9, verticalalignment="top",,0
