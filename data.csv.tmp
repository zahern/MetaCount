        try:,0
            est_train = estimate_log_psi_temporal(,0
                _tf, clusters, df_train, psi_col, all_var_names, cat_set),0
            est_test = estimate_log_psi_temporal(,0
                _tf, clusters, df_test, psi_col, all_var_names, cat_set),0
        except Exception:,0
            est_train = estimate_log_psi(fits, clusters, df_train, psi_col, all_var_names, cat_set),0
            est_test = estimate_log_psi(fits, clusters, df_test, psi_col, all_var_names, cat_set),0
    else:,0
        est_train = estimate_log_psi(fits, clusters, df_train, psi_col, all_var_names, cat_set),0
        est_test = estimate_log_psi(fits, clusters, df_test, psi_col, all_var_names, cat_set),0
    obs_train = np.log(df_train["psi"].astype(float).values),0
    obs_test = np.log(df_test["psi"].astype(float).values),0
,0
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5.5)),0
    for ax, obs, est, label in [(ax1, obs_train, est_train, "Training"),,0
                                  (ax2, obs_test, est_test, "Test")]:,0
        mask = ~np.isnan(obs) & ~np.isnan(est),0
        ax.scatter(est[mask], obs[mask], alpha=0.25, s=5, color="steelblue",,0
                   edgecolors="none"),0
        lo, hi = 1.0, log(5.0),0
        ax.plot([lo, hi], [lo, hi], "r--", lw=1.2),0
        met = compute_metrics(obs, est),0
        valid_obs = obs[mask],0
        valid_est = est[mask],0
        if len(valid_obs) > 1:,0
            tss = float(np.sum((valid_obs - np.mean(valid_obs)) ** 2)),0
            r2_plot = 1.0 - float(np.sum((valid_obs - valid_est) ** 2)) / max(tss, 1e-15),0
        else:,0
            r2_plot = np.nan,0
        ax.set_xlim(lo, hi),0
        ax.set_ylim(lo, hi),0
        ax.set_xlabel("Predicted ln(PSI)", fontsize=12),0
