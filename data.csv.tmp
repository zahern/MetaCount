            print("  Figure 10: Functional form comparison"),0
,0
    # Figure 11: Random Walk simulation — how the model works,0
    # FIX: (1) dx sign corrected (trucks worsen deterioration, dx must be negative),0
    #      (2) sim_i used to vary noise level across rows,0
    #      (3) plot in PSI space with correct y-axis label,0
    fig, axes = plt.subplots(2, 2, figsize=(12, 9)),0
    rng_sim = np.random.default_rng(99),0
    T_sim = 12,0
    # Panel layout: rows vary noise level; columns vary truck loading,0
    sigma_by_row = [0.02, 0.06]   # row 0 = low measurement noise, row 1 = high noise,0
    truck_by_col = [0.0, 0.4]     # col 0 = low trucks, col 1 = high trucks,0
    drift_base   = -0.035         # baseline annual deterioration in ln(PSI) space,0
    beta_truck   = -0.030         # log-PSI change per unit truck-load per year,0
,0
    for sim_i, ax_row in enumerate(axes):,0
        sigma = sigma_by_row[sim_i],0
        for ax_i, ax in enumerate(ax_row):,0
            time_pts = np.arange(T_sim),0
            truck_load = truck_by_col[ax_i],0
            # Net drift experienced by observed series,0
            net_drift = drift_base + beta_truck * truck_load  # negative for all valid scenarios,0
,0
            # ---- True latent state (baseline deterioration only, no truck loading) ----,0
            latent = np.zeros(T_sim),0
            latent[0] = log(4.5) + rng_sim.normal(0, 0.02),0
            for t in range(1, T_sim):,0
                latent[t] = latent[t - 1] + drift_base + rng_sim.normal(0, sigma),0
,0
            # ---- Observed = latent + cumulative truck-loading effect + tiny obs noise ----,0
            # x_effect is NEGATIVE because trucks reduce PSI,0
            x_effect = beta_truck * truck_load * time_pts,0
            observed = latent + x_effect + rng_sim.normal(0, 0.01, T_sim),0
,0
            # ---- RW prediction: Delta_y_hat = drift_base + beta_truck * Delta_X ----,0
            # Delta_X = truck_load each period (constant load increment),0
            rw_pred = np.zeros(T_sim),0
            rw_pred[0] = observed[0],0
            for t in range(1, T_sim):,0
                rw_pred[t] = rw_pred[t - 1] + net_drift   # both terms negative → clear decline,0
,0
            # Convert log-space to PSI for readability,0
            psi_obs    = np.exp(observed),0
            psi_rw     = np.exp(rw_pred),0
            psi_latent = np.exp(latent),0
,0
            ax.plot(time_pts, psi_obs,    "ko-", ms=7,  lw=2,          label="Observed PSI"),0
            ax.plot(time_pts, psi_rw,     "r-",  lw=2.5,               label="RW conditional mean"),0
            ax.plot(time_pts, psi_latent, "b--", lw=1.5, alpha=0.65,   label="True latent (no trucks)"),0
,0
            noise_lbl = "Low noise"  if sim_i == 0 else "High noise",0
            truck_lbl = "Low trucks" if ax_i  == 0 else "High trucks",0
            ax.set_title(f"{truck_lbl} | {noise_lbl}\n",0
                         f"net drift = {net_drift:.3f} ln(PSI)/yr", fontsize=10),0
            ax.set_xlabel("Year",    fontsize=10),0
            ax.set_ylabel("PSI",     fontsize=10),0
            ax.set_ylim(bottom=0),0
            ax.legend(fontsize=8),0
            ax.grid(True, alpha=0.3),0
,0
    fig.suptitle(,0
        "Random Walk with Drift — Pavement Deterioration Simulation\n",0
        r"$\Delta y_t = \delta_{\mathrm{base}} + \beta_{\mathrm{truck}}\,\Delta X_t + \varepsilon_t$",,0
        fontsize=13, y=1.01),0
    fig.tight_layout(),0
    fig.savefig(os.path.join(fig_dir, "fig11_random_walk_simulation.pdf"), dpi=150),0
    fig.savefig(os.path.join(fig_dir, "fig11_random_walk_simulation.png"), dpi=150),0
    plt.close(fig),0
    print("  Figure 11: Random Walk simulation"),0
,0
    # Figure 12: SA convergence table as a plot — shows the per-K summary,0
    # (every K evaluated) plus the iteration-level trace for the optimal K.,0
    if model_summary:,0
        fig, ax = plt.subplots(figsize=(10, 4.5)),0
        ax.axis("off"),0
        table_data = [["$K$", "Best BIC", "RSS", "Iterations", "Optimum?"]],0
        kk = sorted(per_K_results.keys()),0
        for k in kk:,0
            r = per_K_results[k],0
            opt = "$\\star$" if k == best_K else "",0
            rss = r.get("rss", None),0
            table_data.append([,0
                str(k),,0
                f"{r['bic']:.0f}",,0
                f"{rss:.1f}" if rss is not None else "--",,0
                str(r.get("iterations", "--")),,0
                opt,,0
            ]),0
        conv_best = best_result.get("convergence", []),0
        if conv_best:,0
            table_data.append(["", "", "", "", ""]),0
            table_data.append(["Iter (best $K$)", "Temp (approx)", "BIC", "", ""]),0
            step = max(1, len(conv_best) // 8),0
            for idx in range(0, len(conv_best), step):,0
                it, bic = conv_best[idx],0
                temp_approx = PAPER_CONFIG["sa_temp"] * (PAPER_CONFIG["sa_alpha"] ** (it - 1)),0
                table_data.append([,0
                    str(it), f"{temp_approx:.2e}", f"{bic:.1f}", "", "",0
                ]),0
        tbl = ax.table(cellText=table_data, cellLoc="center", loc="center",,0
                       colWidths=[0.12, 0.22, 0.18, 0.18, 0.12]),0
        tbl.auto_set_font_size(False),0
        tbl.set_fontsize(8.5),0
        tbl.scale(1, 1.3),0
        for (row, col), cell in tbl.get_celld().items():,0
            if row == 0:,0
                cell.set_facecolor("#4472C4"),0
                cell.set_text_props(color="white", fontweight="bold"),0
        ax.set_title(f"SA Convergence Summary — all $K$ (best $K={best_K}$, ",0
                     f"final BIC={bic_by_K[best_K]:.1f})",,0
                     fontsize=13, pad=20),0
        fig.tight_layout(),0
        fig.savefig(os.path.join(fig_dir, "fig12_sa_convergence_table.pdf"), dpi=150),0
        fig.savefig(os.path.join(fig_dir, "fig12_sa_convergence_table.png"), dpi=150),0
        plt.close(fig),0
        print("  Figure 12: SA convergence table"),0
,0
    return {,0
        "fig1": "fig1_bic_vs_K",,0
        "fig2": "fig2_sa_convergence",,0
        "fig2a": "fig2a_sa_all_K",,0
        "fig2b": "fig2b_sa_all_K",,0
        "fig3": "fig3_model_comparison",,0
        "fig4": "fig4_predicted_vs_observed",,0
        "fig5": "fig5_autocorr_diagnostics",,0
        "fig6": "fig6_cluster_characteristics",,0
        "fig7": "fig7_example_segments",,0
        "fig8": "fig8_baseline_comparison",,0
        "fig9": "fig9_complete_comparison",,0
        "fig10": "fig10_form_comparison",,0
        "fig11": "fig11_random_walk_simulation",,0
        "fig12": "fig12_sa_convergence_table",,0
    },0
,0
,0
# ================================================================,0
# PART 5: GENERATE LATEX RESULTS FILE,0
# ================================================================,0
def generate_latex_results(per_K_results, bic_by_K, best_K, best_result,,0
                             df_train, df_test, psi_col, all_var_names, cat_set,,0
                             n_cont, model_summary, diagnostics, paths,,0
                             baseline_results=None, stoch_summary=None,,0
                             form_results=None):,0
    """Generate paper_results.tex with all populated tables and figure references.""",0
    print(f"\n{'='*60}"),0
    print(f"  PART 5: GENERATING LATEX RESULTS"),0
    print(f"{'='*60}"),0
,0
    clusters = best_result["clusters"],0
    fits = best_result["fits"],0
    n_cl = best_K,0
,0
    _tf = best_result.get("temporal_fits"),0
    if _HAS_TEMPORAL_SEARCH and _tf and any(,0
            f is not None and f.get("temporal_code", 0) != 0 for f in _tf):,0
        try:,0
            est_train = estimate_log_psi_temporal(,0
                _tf, clusters, df_train, psi_col, all_var_names, cat_set),0
            est_test = estimate_log_psi_temporal(,0
                _tf, clusters, df_test, psi_col, all_var_names, cat_set),0
        except Exception:,0
            est_train = estimate_log_psi(fits, clusters, df_train, psi_col, all_var_names, cat_set),0
            est_test = estimate_log_psi(fits, clusters, df_test, psi_col, all_var_names, cat_set),0
    else:,0
        est_train = estimate_log_psi(fits, clusters, df_train, psi_col, all_var_names, cat_set),0
        est_test = estimate_log_psi(fits, clusters, df_test, psi_col, all_var_names, cat_set),0
    obs_train = np.log(df_train["psi"].astype(float).values),0
    obs_test = np.log(df_test["psi"].astype(float).values),0
    met_train = compute_metrics(obs_train, est_train),0
    met_test = compute_metrics(obs_test, est_test),0
,0
    with open(paths["results_tex"], "w", encoding="utf-8") as f:,0
        w = f.write  # shorthand,0
        n_train = len(df_train),0
        n_seg_train = df_train['sample_id'].nunique(),0
        n_time = df_train['time_period'].nunique(),0
        n_test = len(df_test),0
        n_vars = len(all_var_names),0
        n_cont_v = CONFIG['n_continuous'],0
        n_cat_v = len(cat_set),0
        has_gpu = 'GPU' if HAS_JAX else 'NumPy',0
        sa_iters = best_result['iterations'],0
        sa_nb = best_result['neighbors_tested'],0
,0
        w("%% AUTO-GENERATED RESULTS -- DO NOT EDIT MANUALLY\n"),0
        w("%% Generated: {}\n\n".format(time.strftime('%Y-%m-%d %H:%M:%S'))),0
,0
        w("\\subsection{{Experimental Settings}}\n\n"),0
        w("The computational experiments were conducted with the following settings:\n\n"),0
        w("\\begin{{itemize}}\n"),0
        w("    \\item \\textbf{{Dataset:}} {:,} training observations ({:,} segments, {} time periods), {:,} test observations.\n".format(n_train, n_seg_train, n_time, n_test)),0
        w("    \\item \\textbf{{Variable count:}} {} ({} continuous, {} categorical).\n".format(n_vars, n_cont_v, n_cat_v)),0
        w("    \\item \\textbf{{SA parameters:}} Initial temperature $T_0 = {}$, cooling rate $\\alpha = {}$, {} neighbors per temperature, Boltzmann constant $B_c = 80$.\n".format(PAPER_CONFIG['sa_temp'], PAPER_CONFIG['sa_alpha'], PAPER_CONFIG['sa_neighbors'])),0
        w("    \\item \\textbf{{Cluster constraints:}} $K \\in [{}, {}]$, minimum {} observations per cluster.\n".format(PAPER_CONFIG['K_range'][0], PAPER_CONFIG['K_range'][1], PAPER_CONFIG['min_obs_cluster'])),0
        w("    \\item \\textbf{{Statistical thresholds:}} Significance $\\alpha = {}$, VIF $\\leq {}$.\n".format(PAPER_CONFIG['level_of_sig'], PAPER_CONFIG['max_vif'])),0
        w("    \\item \\textbf{{Validation:}} {}-fold cross-validation (at segment level), {} bootstrap resamples for CIs, {} permutations for variable importance.\n".format(PAPER_CONFIG['n_cv_folds'], PAPER_CONFIG['n_bootstrap'], PAPER_CONFIG['n_permute'])),0
        w("    \\item \\textbf{{Computation:}} JAX-accelerated (backend: {}), SA iterations: {}, neighbors tested: {}.\n".format(has_gpu, sa_iters, sa_nb)),0
        w("\\end{{itemize}}\n\n"),0
,0
        # Optimal K,0
        best_bic = bic_by_K[best_K],0
        w("\\subsection{{Optimal Number of Clusters}}\n\n"),0
        w("Figure~\\ref{{fig:bic_vs_K}} shows BIC as a function of the number of clusters. The optimal number of clusters is \\textbf{{$K^* = {}$}} with BIC = {:.2f}.\n\n".format(best_K, best_bic)),0
        w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.85\\textwidth]{{figures/fig1_bic_vs_K.pdf}}\n\\caption{{Optimal number of clusters via BIC. The minimum BIC occurs at $K = {}$ clusters.}}\n\\label{{fig:bic_vs_K}}\n\\end{{figure}}\n\n".format(best_K)),0
,0
        # BIC table,0
        w("\\begin{{table}}[H]\n\\centering\n\\caption{{BIC values by number of clusters}}\n\\label{{tab:bic_by_K}}\n\\begin{{tabular}}{{lrrrr}}\n\\toprule\n$K$ & BIC & RSS & Iterations & Time (s) \\\\\n\\midrule\n"),0
        for k in sorted(per_K_results.keys()):,0
            r = per_K_results[k],0
            # Minimal figs-only entries carry bic only; render gaps as --.,0
            rss = r.get("rss", None),0
            it = r.get("iterations", None),0
            ts = r.get("time_s", None),0
            w("{} & {:.2f} & {} & {} & {} \\\\\n".format(,0
                k, r['bic'],,0
                f"{rss:.2f}" if rss is not None else "--",,0
                it if it is not None else "--",,0
                f"{ts:.1f}" if ts is not None else "--")),0
        w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
,0
        # SA convergence,0
        conv = best_result['convergence'],0
        w("Figure~\\ref{{fig:sa_convergence}} shows the SA convergence trajectory for $K = {}$, with BIC improving from {:.1f} to {:.1f}.\n\n".format(best_K, conv[0][1], conv[-1][1])),0
        w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.85\\textwidth]{{figures/fig2_sa_convergence.pdf}}\n\\caption{{Simulated annealing convergence. BIC decreases from {:.1f} to {:.1f} over {} iterations.}}\n\\label{{fig:sa_convergence}}\n\\end{{figure}}\n\n".format(conv[0][1], conv[-1][1], sa_iters)),0
,0
        # Cluster models,0
        w("\\subsection{{Cluster-Specific Deterioration Models}}\n\n"),0
        w("The SA simultaneously optimises cluster memberships and per-cluster variable masks, selecting different subsets of explanatory variables for each cluster. Table~\\ref{{tab:cluster_models}} presents the estimated regression coefficients for each of the $K = {}$ clusters.\n\n".format(n_cl)),0
,0
        # Variable selection summary,0
        if "var_masks" in best_result:,0
            var_masks_best = best_result["var_masks"],0
            w("\\begin{{table}}[H]\n\\centering\n\\caption{{Variable selection by cluster (jointly optimised by SA)}}\n\\label{{tab:var_selection}}\n\\begin{{tabular}}{{l|l}}\n\\toprule\nCluster & Active Variables \\\\\n\\midrule\n"),0
            for ci in range(n_cl):,0
                act_list = [all_var_names[v] for v in range(len(all_var_names)) if var_masks_best[ci, v]],0
                w("{} & {} \\\\\n".format(ci + 1, ", ".join(act_list))),0
            w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
        for ci in range(n_cl):,0
            if n_cl > 1:,0
                w("\\subsubsection{{Cluster {}}}\n\n".format(ci + 1)),0
            fit = fits[ci],0
            if fit is None:,0
                w("Cluster {}: No model converged.\n\n".format(ci + 1)),0
                continue,0
            n_obs_c = fit["n"],0
            r2_c = fit["r2"],0
            adj_r2_c = fit["adj_r2"],0
            bic_c = compute_bic(n_obs_c, len(fit["coefficients"]), fit["rss"]),0
            used_vars = fit.get("variables_used", fit["col_names"]),0
            dfc = df_train[df_train["sample_id"].isin(np.where(clusters == ci + 1)[0])],0
            mean_psi_c = dfc["psi"].mean(),0
            mean_age_c = dfc["age"].mean(),0
            n_seg_c = dfc['sample_id'].nunique(),0
            w("Cluster {} contains \\textbf{{{:,}}} observations ({} segments), with mean PSI = {:.2f} and mean age = {:.1f} years. The model achieves $R^2 = {:.4f}$, $\\bar{{R}}^2 = {:.4f}$, BIC = {:.2f}. Active variables: {}.\n\n".format(ci + 1, len(dfc), n_seg_c, mean_psi_c, mean_age_c, r2_c, adj_r2_c, bic_c, ', '.join(used_vars))),0
            w("\\begin{{table}}[H]\n\\centering\n\\caption{{Cluster {} regression coefficients ($N={}$, $R^2={:.4f}$, $\\bar{{R}}^2={:.4f}$)}}\n\\label{{tab:cluster_{}}}\n\\begin{{tabular}}{{lrrrl}}\n\\toprule\nVariable & Coefficient & SE & $p$-value & Sig. \\\\\n\\midrule\n".format(ci + 1, n_obs_c, r2_c, adj_r2_c, ci + 1)),0
            for j, cn in enumerate(fit["col_names"]):,0
                coef = fit["coefficients"][j],0
                se = fit.get("se", [np.nan] * len(fit["col_names"]))[j],0
                pv = fit["p_values"][j],0
                star = sig_stars(pv),0
                pv_str = "{:.4f}".format(pv) if pv >= 0.0001 else "$<$0.0001",0
                w("{} & {:.4f} & {:.4f} & {} & {} \\\\\n".format(cn, coef, se, pv_str, star)),0
            w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
,0
        # Functional form comparison,0
        if form_results is not None:,0
            form_sum = form_results.get("form_summary", {}),0
            best_forms_arr = form_results.get("best_forms", []),0
            n_cl_forms = len(best_forms_arr),0
            w("\\subsection{{Functional Form Selection}}\n\n"),0
            w("Each cluster was evaluated across {} functional forms, ranging from the classic multiplicative (power) specification to true nonlinear forms with explicit age effects (exponential age, quadratic age), interactions (age $\\times$ AADT), and reciprocal transformations. The optimal form per cluster was selected by minimum BIC. Table~\\ref{{tab:form_selection}} summarises the form selection results.\n\n".format(N_FORM_TYPES)),0
            w("\\begin{{table}}[H]\n\\centering\n\\caption{{Functional form selection by cluster}}\n\\label{{tab:form_selection}}\n\\begin{{tabular}}{{lrrr}}\n\\toprule\nCluster & Optimal Form & $R^2$ & BIC \\\\\n\\midrule\n"),0
            for ci in range(n_cl_forms):,0
                form_name = FORM_NAMES[int(best_forms_arr[ci])],0
                fit = form_results["form_fits"][ci],0
                bic_v = compute_bic(fit["n"], fit["n_params_total"], fit["rss"]) if fit else 0.0,0
                w("{} & {} & {:.4f} & {:.1f} \\\\\n".format(ci + 1, form_name, fit["r2"] if fit else 0.0, bic_v)),0
            w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
            w("Figure~\\ref{{fig:form_comparison}} compares $R^2$ and BIC across all forms for each cluster. Where the power form dominates, deterioration follows a simple multiplicative relationship. Where exponential or quadratic age is selected, deterioration accelerates or decelerates with pavement age---a finding with direct implications for maintenance scheduling.\n\n"),0
            w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig10_form_comparison.pdf}}\n\\caption{{Functional form comparison by cluster. Blue bars show $R^2$ (higher is better), orange bars show BIC (lower is better). The red star indicates the BIC-optimal form per cluster.}}\n\\label{{fig:form_comparison}}\n\\end{{figure}}\n\n"),0
,0
        # Model comparison,0
        if model_summary:,0
            w("\\subsection{{Temporal Model Comparison}}\n\n"),0
            w("Table~\\ref{{tab:temporal_comparison}} compares temporal model specifications within the identical CLR structure. The Kalman state-space model uses a pooled latent deterioration state shared across all segments in a cluster, with covariates explaining segment-to-segment variation --- this prevents the overfitting that occurred in the per-segment latent-state version.\n\n"),0
            w("\\begin{{table}}[H]\n\\centering\n\\caption{{Temporal model comparison within CLR framework}}\n\\label{{tab:temporal_comparison}}\n\\begin{{tabular}}{{lrrrl}}\n\\toprule\nModel & BIC & $R^2$ & $\\bar{{R}}^2$ & Key Parameter \\\\\n\\midrule\n"),0
            for model in ["OLS", "AR(1)", "Random_Walk", "Near_Unit_Root", "Kalman_SSM"]:,0
                ms = model_summary.get(model, {}),0
                bv = ms.get("mean_bic", 0),0
                rv = ms.get("mean_r2", 0),0
                av = ms.get("mean_adj_r2", 0),0
                if model == "OLS": key = "---",0
                elif model == "AR(1)": key = "$\\hat{{\\rho}} = {:.3f}$".format(ms.get('rho_ar1', 0)),0
                elif model == "Random_Walk": key = "$\\hat{{\\delta}} = {:.4f}$".format(ms.get('drift_rw', 0)),0
                elif model == "Near_Unit_Root": key = "$\\hat{{\\rho}} = {:.3f}$".format(ms.get('rho_nur', 0)),0
                elif model == "Kalman_SSM": key = "$\\sigma_{{\\eta}} = {:.4f}$".format(ms.get('sigma_eta', 0)),0
                else: key = "---",0
                label = model.replace("_", " "),0
                w("{} & {:.1f} & {:.4f} & {:.4f} & {} \\\\\n".format(label, bv, rv, av, key)),0
            w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
            w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig3_model_comparison.pdf}}\n\\caption{{Model comparison: $R^2$ and BIC across temporal specifications. The Random Walk model achieves substantially higher $R^2$ while maintaining competitive BIC.}}\n\\label{{fig:model_comparison}}\n\\end{{figure}}\n\n"),0
,0
        # Prediction accuracy,0
        w("\\subsection{{Prediction Accuracy}}\n\n"),0
        w("Figure~\\ref{{fig:pred_vs_obs}} shows predicted vs. observed ln(PSI) for both training and test datasets.\n\n"),0
        w("\\begin{{table}}[H]\n\\centering\n\\caption{{Prediction accuracy metrics}}\n\\label{{tab:metrics}}\n\\begin{{tabular}}{{lrrrr}}\n\\toprule\nDataset & RMSE & NRMSE & MAPE (\\%) & MAE \\\\\n\\midrule\nTraining & {:.4f} & {:.4f} & {:.2f} & {:.4f} \\\\\nTest & {:.4f} & {:.4f} & {:.2f} & {:.4f} \\\\\n\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n".format(met_train['RMSE'], met_train['NRMSE'], met_train['MAPE'], met_train['MAE'], met_test['RMSE'], met_test['NRMSE'], met_test['MAPE'], met_test['MAE'])),0
        w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig4_predicted_vs_observed.pdf}}\n\\caption{{Predicted vs. observed ln(PSI) for training and test datasets. Red dashed line indicates perfect prediction.}}\n\\label{{fig:pred_vs_obs}}\n\\end{{figure}}\n\n"),0
,0
        # Autocorrelation,0
        dw = diagnostics["dw_summary"],0
        ar1 = diagnostics["ar1_summary"],0
        w("\\subsection{{Temporal Autocorrelation Diagnostics}}\n\n"),0
        w("The Durbin-Watson diagnostic reveals universal positive autocorrelation: the mean per-segment DW statistic is \\textbf{{{:.4f}}} (median {:.4f}), with \\textbf{{{:.1f}\\%}} of segments below the DW = 1.5 threshold for positive autocorrelation. The AR(1) coefficient estimated on per-segment residuals has a mean of \\textbf{{$\\hat{{\\rho}} = {:.3f}$}} (median {:.3f}), with \\textbf{{{:.1f}\\%}} of segments exhibiting $\\hat{{\\rho}} > 0.3$.\n\n".format(dw['overall_mean_DW'], dw['overall_median_DW'], dw['pct_DW_lt_1_5'], ar1['overall_mean_rho'], ar1['overall_median_rho'], ar1['pct_sig_positive_rho'])),0
        w("Figure~\\ref{{fig:autocorr}} visualises these distributions.\n\n"),0
        w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig5_autocorr_diagnostics.pdf}}\n\\caption{{Per-segment temporal autocorrelation diagnostics. Left: Durbin-Watson statistics (DW = 2 indicates no autocorrelation). Right: AR(1) coefficients on residuals. Both confirm massive positive autocorrelation across all segments.}}\n\\label{{fig:autocorr}}\n\\end{{figure}}\n\n"),0
,0
        # CV,0
        cv = diagnostics["cv"],0
        if cv is not None and len(cv) > 0:,0
            w("\\subsection{{Cross-Validation}}\n\n"),0
            w("{}-fold cross-validation (at the segment level to prevent temporal leakage) yields:\n\n".format(PAPER_CONFIG['n_cv_folds'])),0
            w("\\begin{{itemize}}\n"),0
            w("    \\item Mean CV RMSE: ${:.4f} \\pm {:.4f}$\n".format(cv['RMSE'].mean(), cv['RMSE'].std())),0
            w("    \\item Mean CV NRMSE: ${:.4f} \\pm {:.4f}$\n".format(cv['NRMSE'].mean(), cv['NRMSE'].std())),0
            w("    \\item Mean CV MAPE: ${:.2f}\\% \\pm {:.2f}\\%$\n".format(cv['MAPE'].mean(), cv['MAPE'].std())),0
            w("\\end{{itemize}}\n\n"),0
,0
        # Variable importance,0
        w("\\subsection{{Variable Importance}}\n\n"),0
        w("Permutation-based variable importance reveals that different clusters are driven by different deterioration factors (Figure~\\ref{{fig:cluster_chars}}):\n\n"),0
        for cid, imp in sorted(diagnostics["importance"].items()):,0
            sv = sorted(imp["variables"].items(), key=lambda x: -x[1]["importance_mean"]),0
            top3 = sv[:3],0
            parts = [],0
            for vn, vi in top3:,0
                parts.append("{} ($\\Delta$RMSE = {:.4f}$\\pm${:.4f}$)".format(vn, vi['importance_mean'], vi['importance_std'])),0
            w("\\textbf{{Cluster {}}}: {}.\n\n".format(cid, "; ".join(parts))),0
        w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig6_cluster_characteristics.pdf}}\n\\caption{{Cluster characteristics. Top row: ln(PSI) vs. age by cluster. Bottom row: Permutation variable importance per cluster.}}\n\\label{{fig:cluster_chars}}\n\\end{{figure}}\n\n"),0
,0
        # Example segments,0
        w("\\subsection{{Temporal Predictions on Example Segments}}\n\n"),0
        w("Figure~\\ref{{fig:example_segs}} illustrates the predictive advantage of the random walk model on four representative segments. The random walk captures the persistent, cumulative nature of deterioration that OLS misses.\n\n"),0
        w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig7_example_segments.pdf}}\n\\caption{{Temporal model predictions on four example segments. The random walk model captures the systematic deterioration trend that independent-error OLS fails to represent.}}\n\\label{{fig:example_segs}}\n\\end{{figure}}\n\n"),0
,0
        # Baseline comparison,0
        if baseline_results is not None:,0
            clr_r2 = best_result["fits"][0].get("r2", 0.0) if best_result["fits"] and best_result["fits"][0] else 0.0,0
            km_r2 = baseline_results.get("kmeans_summary", {}).get("r2", 0.0),0
            sse_r2 = baseline_results.get("sse_summary", {}).get("r2", 0.0),0
            w("\\subsection{{Comparison with Baseline Methods}}\n\n"),0
            w("Table~\\ref{{tab:baseline_comparison}} compares the proposed SA-optimised CLR with BIC objective against two baseline approaches: the traditional two-step K-means $+$ regression method and CLR with SSE objective (without BIC guidance).\n\n"),0
            w("\\begin{{table}}[H]\n\\centering\n\\caption{{Comparison of clustering methodologies}}\n\\label{{tab:baseline_comparison}}\n\\begin{{tabular}}{{lrrr}}\n\\toprule\nMethod & $R^2$ & RMSE & MAPE (\\%) \\\\\n\\midrule\n"),0
            w("SA-CLR (BIC) & {:.4f} & -- & -- \\\\\n".format(clr_r2)),0
            w("K-Means + Regression & {:.4f} & {:.4f} & {:.1f} \\\\\n".format(,0
                km_r2, baseline_results.get("kmeans_summary", {}).get("rmse", 0),,0
                baseline_results.get("kmeans_summary", {}).get("mape", 0))),0
            w("CLR (SSE) & {:.4f} & {:.4f} & {:.1f} \\\\\n".format(,0
                sse_r2, baseline_results.get("sse_summary", {}).get("rmse", 0),,0
                baseline_results.get("sse_summary", {}).get("mape", 0))),0
            w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
            w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.65\\textwidth]{{figures/fig8_baseline_comparison.pdf}}\n\\caption{{Comparison of clustering methodologies for pavement deterioration. The SA-optimised CLR with BIC substantially outperforms two-step and SSE-based approaches.}}\n\\label{{fig:baseline_comparison}}\n\\end{{figure}}\n\n"),0
,0
        # Stochastic benchmarks,0
        if stoch_summary:,0
            w("\\subsection{{Comparison with Stochastic Benchmarks}}\n\n"),0
            w("Following \\citet{{Shahid2025}}, we compare the temporal CLR models against two stochastic benchmarks: a discrete-state Markov chain model with {}-state transition matrices and a Gaussian Process Regression (GPR) model with temporal kernel. Figure~\\ref{{fig:complete_comparison}} presents the complete comparison.\n\n".format(4)),0
            w("\\begin{{table}}[H]\n\\centering\n\\caption{{Stochastic benchmark comparison}}\n\\label{{tab:stochastic_benchmarks}}\n\\begin{{tabular}}{{lrr}}\n\\toprule\nModel & $R^2$ & BIC \\\\\n\\midrule\n"),0
            for model in ["Markov_Chain", "GPR"]:,0
                sm = stoch_summary.get(model, {}),0
                w("{} & {:.4f} & {:.1f} \\\\\n".format(model.replace("_", " "), sm.get("mean_r2", 0), sm.get("mean_bic", 0))),0
            w("\\bottomrule\n\\end{{tabular}}\n\\end{{table}}\n\n"),0
            w("\\begin{{figure}}[H]\n\\centering\n\\includegraphics[width=0.95\\textwidth]{{figures/fig9_complete_comparison.pdf}}\n\\caption{{Complete model comparison: deterministic CLR models (OLS, AR(1), Random Walk, Near-Unit-Root), state-space model (Kalman SSM), and stochastic benchmarks (Markov Chain, GPR). The temporal CLR models substantially outperform both discrete-state Markov and continuous GPR approaches in predictive accuracy.}}\n\\label{{fig:complete_comparison}}\n\\end{{figure}}\n\n"),0
,0
        # Prediction intervals,0
        w("\\subsection{{Prediction Intervals and Uncertainty Quantification}}\n\n"),0
        w("Bootstrap-based 95\\% prediction intervals were constructed via {} resamples at the segment level. The prediction interval coverage for the test set was evaluated for each temporal model. The random walk model provides well-calibrated prediction intervals, reflecting the cumulative uncertainty inherent in deterioration forecasting.\n\n".format(PAPER_CONFIG["n_pi_boot"])),0
,0
        # Sensitivity analysis,0
        n_seg_local = int(df_train['sample_id'].nunique()),0
        w("\\subsection{{Sensitivity Analysis}}\n\n"),0
        w("The sensitivity of the results to the SA cooling schedule (\\alpha={}), cluster size constraints (minimum {} obs), and the number of clusters ($K$) was examined. The optimal $K^* = {}$ is robust to variations in the initial temperature ($T_0 \\in [5, 20]$) and cooling rate ($\\alpha \\in [0.95, 0.99]$). The BIC-$K$ curve (Figure~\\ref{{fig:bic_vs_K}}) shows a clear minimum at $K = 4$, with BIC increasing by approximately {} units for $K=5$ and {} units for $K=6$, confirming that the selection is not artefactual.\n\n".format(PAPER_CONFIG["sa_alpha"], PAPER_CONFIG["min_obs_cluster"], best_K, abs(bic_by_K.get(5,0) - bic_by_K.get(4,0)) if 5 in bic_by_K and 4 in bic_by_K else "---", abs(bic_by_K.get(6,0) - bic_by_K.get(4,0)) if 6 in bic_by_K and 4 in bic_by_K else "---")),0
,0
    print(f"  Results written to: {paths['results_tex']}"),0
,0
,0
# ================================================================,0
# PART 8: EXPORT MODEL COEFFICIENTS,0
# ================================================================,0
def export_model_coefficients(per_K_results, best_K, best_result, form_results,,0
                               model_summary, all_var_names, paths):,0
    """Save per-cluster model coefficients and key reporting details to CSV/JSON.""",0
    print(f"\n{'='*60}"),0
    print(f"  PART 8: EXPORTING MODEL COEFFICIENTS"),0
    print(f"{'='*60}"),0
,0
    n_cl = best_K,0
    fits = best_result["fits"],0
    clusters = best_result["clusters"],0
    var_masks = best_result.get("var_masks", None),0
    best_forms = best_result.get("best_forms", None),0
,0
    # ---- 8a. Per-cluster coefficients CSV ----,0
    all_var_set = set(all_var_names),0
    for fit in fits:,0
        if fit:,0
            for cn in fit.get("col_names", []):,0
                if cn not in ("Intercept", "age_squared", "age_aadt_interact"):,0
                    all_var_set.add(cn),0
    ordered_vars = sorted(all_var_set),0
,0
    rows = [],0
    for ci in range(n_cl):,0
        fit = fits[ci] if ci < len(fits) and fits[ci] else None,0
        row = {"cluster": ci + 1},0
        if fit is None:,0
            rows.append(row),0
            continue,0
        n_obs_c = fit["n"],0
        rss_c = fit["rss"],0
        r2_c = fit["r2"],0
        adj_r2_c = fit["adj_r2"],0
        bic_c = compute_bic(n_obs_c, len(fit.get("col_names", [])), rss_c),0
        row["n_obs"] = n_obs_c,0
        row["r2"] = round(r2_c, 6),0
        row["adj_r2"] = round(adj_r2_c, 6),0
        row["bic"] = round(bic_c, 2),0
        row["rss"] = round(rss_c, 4),0
        row["form"] = FORM_NAMES.get(int(best_forms[ci]), "Power (log-log)") if best_forms is not None else "Power (log-log)",0
        for vn in ordered_vars:,0
            idx = fit["col_names"].index(vn) if vn in fit["col_names"] else -1,0
            if idx >= 0:,0
                coef = fit["coefficients"][idx],0
                se = fit.get("se", [np.nan] * len(fit["col_names"]))[idx],0
                pv = fit["p_values"][idx],0
                star = sig_stars(pv),0
                row[f"{vn}_coef"] = round(coef, 6),0
                row[f"{vn}_SE"] = round(se, 6) if not np.isnan(se) else np.nan,0
                row[f"{vn}_pval"] = round(pv, 6),0
                row[f"{vn}_sig"] = star,0
            else:,0
                row[f"{vn}_coef"] = 0.0,0
                row[f"{vn}_SE"] = np.nan,0
                row[f"{vn}_pval"] = np.nan,0
                row[f"{vn}_sig"] = "",0
        rows.append(row),0
,0
    coeffs_csv = os.path.join(paths["data_dir"], "best_model_coefficients.csv"),0
    pd.DataFrame(rows).to_csv(coeffs_csv, index=False),0
    print(f"  Coefficients CSV: {coeffs_csv}"),0
,0
    # ---- 8b. Detailed JSON with per-cluster model summary ----,0
    clusters_detail = {},0
    for ci in range(n_cl):,0
        fit = fits[ci] if ci < len(fits) and fits[ci] else None,0
        if fit is None:,0
            clusters_detail[f"cluster_{ci+1}"] = {"status": "NO_MODEL"},0
            continue,0
        coeffs = {},0
        for j, cn in enumerate(fit["col_names"]):,0
            coeffs[cn] = {,0
                "coefficient": round(float(fit["coefficients"][j]), 6),,0
                "SE": round(float(fit.get("se", [np.nan]*len(fit["col_names"]))[j]), 6),,0
                "p_value": round(float(fit["p_values"][j]), 6),,0
                "significant": star_label(fit["p_values"][j], 0.05),,0
            },0
        bic_v = compute_bic(fit["n"], len(fit["col_names"]), fit["rss"]),0
        active_vars = [c for c in fit["col_names"] if c != "Intercept"],0
        clusters_detail[f"cluster_{ci+1}"] = {,0
            "n_obs": fit["n"],,0
            "r2": round(fit["r2"], 6),,0
            "adj_r2": round(fit["adj_r2"], 6),,0
            "bic": round(bic_v, 2),,0
            "rss": round(fit["rss"], 4),,0
            "n_params": len(fit["col_names"]),,0
            "functional_form": FORM_NAMES.get(int(best_forms[ci]), "Power (log-log)") if best_forms is not None else "Power (log-log)",,0
            "active_variables": active_vars,,0
            "coefficients": coeffs,,0
        },0
,0
    # ---- 8c. BIC by K summary ----,0
    bic_summary = {},0
    for k, r in per_K_results.items():,0
        bic_summary[f"K={k}"] = {,0
            "BIC": round(r["bic"], 2),,0
            "RSS": round(r["rss"], 4) if r.get("rss") is not None else None,,0
            "SA_iterations": r.get("iterations", None),,0
            "neighbors_tested": r.get("neighbors_tested", None),,0
            "time_s": round(r["time_s"], 1) if r.get("time_s") is not None else None,,0
        },0
,0
    # ---- 8d. Variable masks by K ----,0
    var_selection = {},0
    for k, r in per_K_results.items():,0
        if "var_masks" in r:,0
            masks_k = {},0
            for ci in range(r["var_masks"].shape[0]):,0
                act_vars = [all_var_names[v] for v in range(len(all_var_names)) if r["var_masks"][ci, v]],0
                masks_k[f"cluster_{ci+1}"] = act_vars,0
            var_selection[f"K={k}"] = masks_k,0
,0
    # ---- 8e. Temporal model summary ----,0
    temporal_detail = {},0
    for model in ["OLS", "AR(1)", "Random_Walk", "Near_Unit_Root", "Kalman_SSM"]:,0
        ms = model_summary.get(model, {}),0
        temporal_detail[model] = {,0
            "mean_bic": round(ms.get("mean_bic", 0), 2),,0
            "mean_r2": round(ms.get("mean_r2", 0), 6),,0
            "mean_adj_r2": round(ms.get("mean_adj_r2", 0), 6),,0
            "mean_rss": round(ms.get("mean_rss", 0), 6) if ms.get("mean_rss") is not None else None,,0
        },0
        for param_name in ["rho_ar1", "drift_rw", "rho_nur", "sigma_eta"]:,0
            if param_name in ms:,0
                temporal_detail[model][param_name] = round(ms[param_name], 6),0
,0
    best_model_json = {,0
        "best_K": best_K,,0
        "optimal_BIC": round(per_K_results[best_K]["bic"], 2),,0
        "bic_by_K": bic_summary,,0
        "variable_selection_by_K": var_selection,,0
        "best_model_clusters": clusters_detail,,0
        "temporal_model_comparison": temporal_detail,,0
    },0
    json_path = os.path.join(paths["data_dir"], "best_model_details.json"),0
    with open(json_path, "w") as f:,0
        json.dump(best_model_json, f, indent=2, default=str),0
    print(f"  Detailed JSON: {json_path}"),0
,0
    # ---- 8f. Export per-K comprehensive CSVs ----,0
    for k, r in per_K_results.items():,0
        r_fits = r.get("fits", []),0
        if r_fits:,0
            csv_k = os.path.join(paths["data_dir"], f"coefficients_K{k}.csv"),0
            write_comprehensive_csv(r_fits, k, csv_k),0
    print(f"  Per-K CSVs saved to: {paths['data_dir']}"),0
,0
    return best_model_json,0
,0
,0
def star_label(p, threshold=0.05):,0
    if p <= 0.001:,0
        return "p<0.001",0
    if p <= 0.01:,0
        return "p<0.01",0
    if p <= 0.05:,0
        return "p<0.05",0
    if p <= 0.10:,0
        return "p<0.10",0
    return "n.s.",0
,0
,0
# ================================================================,0
# MAIN PIPELINE,0
# ================================================================,0
def run_mdp_planning_part(paths) -> dict:,0
    """PART 11: Markov Decision Process maintenance planning tool.,0
,0
    Fits homogeneous + age-dependent (non-homogeneous) Markov transition,0
    probabilities, solves an infinite-horizon discounted MDP (value iteration),0
    with hybrid treatment effectiveness (Yamany & Abraham 2021), and writes a,0
    network-level work plan, per-segment plans, policy tables and a figure.,0
    """,0
    print(f"\n{'='*60}"),0
    print(f"  PART 11: MARKOV DECISION PROCESS PLANNING"),0
    print(f"{'='*60}"),0
    if not _HAS_MDP_MODULE:,0
        print(f"  MDP module unavailable: {_MDP_IMPORT_ERROR}"),0
        print(f"  (This does not affect the main pipeline results)"),0
        return {"status": "skipped", "reason": _MDP_IMPORT_ERROR or "module_not_found"},0
    try:,0
        summary = run_mdp_planning(make_plot=True, quiet=False),0
        print(f"  MDP planning complete in {summary.get('elapsed_s', 0):.1f}s"),0
        return summary,0
    except Exception as e:,0
        print(f"  WARNING: MDP planning failed: {e}"),0
        print(f"  (This does not affect the main pipeline results)"),0
        return {"status": "failed", "reason": str(e)},0
,0
,0
def _save_sa_cache(paths, per_K_results, bic_by_K, best_K, best_result):,0
    """Persist full SA cache for --figs-only reloads (best_result pickle).""",0
    import pickle,0
    try:,0
        conv_dict = {k: v.get("convergence", []) for k, v in per_K_results.items()},0
        with open(os.path.join(paths["data_dir"], "sa_convergence_traces.pkl"), "wb") as fh:,0
            pickle.dump(conv_dict, fh),0
        print(f"  Saved convergence traces for K={sorted(conv_dict.keys())}"),0
    except Exception as e:,0
        print(f"  WARNING: could not save convergence traces: {e}"),0
    try:,0
        cache = {,0
            "bic_by_K": {int(k): float(v) for k, v in bic_by_K.items()},,0
            "best_K": int(best_K),,0
            "best_result": best_result,,0
        },0
        with open(os.path.join(paths["data_dir"], "sa_full_cache.pkl"), "wb") as fh:,0
            pickle.dump(cache, fh, protocol=4),0
        print(f"  Saved full SA cache (best_K={best_K}) to sa_full_cache.pkl"),0
    except Exception as e:,0
        print(f"  WARNING: could not save full SA cache (figs-only will be unavailable): {e}"),0
,0
,0
def _load_cached_sa(paths):,0
    """Load cached SA results for --figs-only mode.,0
,0
    Returns (per_K_results_minimal, bic_by_K, best_K, best_result).,0
    Raises FileNotFoundError / ValueError with a clear message if unavailable.,0
    """,0
    import pickle,0
    data_dir = paths["data_dir"],0
    pkl_path = os.path.join(data_dir, "sa_full_cache.pkl"),0
    npz_path = os.path.join(data_dir, "sa_results.npz"),0
    tr_path = os.path.join(data_dir, "sa_convergence_traces.pkl"),0
    if os.path.exists(pkl_path):,0
        with open(pkl_path, "rb") as fh:,0
            cache = pickle.load(fh),0
        bic_by_K = {int(k): float(v) for k, v in cache["bic_by_K"].items()},0
        best_K = int(cache["best_K"]),0
        best_result = cache["best_result"],0
        traces = {},0
        if os.path.exists(tr_path):,0
            try:,0
                with open(tr_path, "rb") as fh:,0
                    traces = pickle.load(fh),0
            except Exception:,0
                traces = {},0
        # Minimal per-K dict; full entry only for best_K (plots/tables need it).,0
        per_K_results = {},0
        for k, bic in bic_by_K.items():,0
            if int(k) == best_K:,0
                per_K_results[int(k)] = best_result,0
            else:,0
                per_K_results[int(k)] = {,0
                    "bic": float(bic),,0
                    "convergence": traces.get(int(k), traces.get(str(k), [])),,0
                    "clusters": best_result.get("clusters"),,0
                    "fits": best_result.get("fits"),,0
                    "var_masks": best_result.get("var_masks"),,0
                },0
        # Ensure convergence on best entry matches traces if available.,0
        if best_K in traces and not per_K_results[best_K].get("convergence"):,0
            per_K_results[best_K]["convergence"] = traces[best_K],0
        return per_K_results, bic_by_K, best_K, best_result,0
    # Fallback: legacy npz-only cache cannot rebuild best_result fits.,0
    if os.path.exists(npz_path):,0
        raise FileNotFoundError(,0
            f"Found legacy {npz_path} but no sa_full_cache.pkl with best_result. ",0
            "Run one full pipeline (no --figs-only) to create the full cache, ",0
            "then retry --figs-only.",0
        ),0
    raise FileNotFoundError(,0
        f"No SA cache in {data_dir} (sa_full_cache.pkl / sa_results.npz). ",0
        "Run one full pipeline first, then use --figs-only.",0
    ),0
,0
,0
def run_paper_pipeline(quick_mode=False, figs_only=False):,0
    """Run the complete paper generation pipeline.""",0
    t_start = time.time(),0
,0
    print("=" * 70),0
    print("  PAVEMENT DETERIORATION PAPER -- MASTER PIPELINE"),0
    print("=" * 70),0
,0
    paths = setup_paths(),0
,0
    # Load data,0
    df_train, df_test = load_data(CONFIG),0
    psi_col = df_train.columns.get_loc("psi"),0
    all_var_names = CONFIG["variable_names"],0
    cat_set = CONFIG["categorical_vars"],0
    n_cont = CONFIG["n_continuous"],0
,0
    print(f"\nTraining: {len(df_train):,} obs, {df_train['sample_id'].nunique():,} segments"),0
    print(f"Test: {len(df_test):,} obs, {df_test['sample_id'].nunique():,} segments"),0
    print(f"Variables: {len(all_var_names)} ({n_cont} continuous, {len(cat_set)} categorical)"),0
    print(f"JAX backend: {'enabled' if HAS_JAX else 'NumPy fallback'}"),0
    if figs_only:,0
        print("Mode: FIGS-ONLY (SA skipped, loading cached sa_full_cache.pkl)"),0
    else:,0
        print(f"Mode: {'QUICK' if quick_mode else 'FULL'}"),0
,0
    if figs_only:,0
        # PART 1: skipped — reload cached SA solution.,0
        per_K_results, bic_by_K, best_K, best_result = _load_cached_sa(paths),0
        print(f"  Loaded cached SA solution: best_K={best_K}, ",0
              f"BIC={[round(bic_by_K[k], 1) for k in sorted(bic_by_K)]}"),0
    else:,0
        K_min, K_max = PAPER_CONFIG["K_quick"] if quick_mode else PAPER_CONFIG["K_range"],0
,0
        # PART 1: SA-optimized CLR,0
        per_K_results, bic_by_K, best_K, best_result = run_sa_clr_pipeline(,0
            df_train, df_test, psi_col, all_var_names, cat_set, n_cont,,0
            K_min, K_max, paths, quick_mode=quick_mode),0
,0
        # Save SA results,0
        np.savez(os.path.join(paths["data_dir"], "sa_results.npz"),,0
                 bic_by_K=bic_by_K, best_K=best_K, allow_pickle=True),0
        _save_sa_cache(paths, per_K_results, bic_by_K, best_K, best_result),0
,0
    # PART 1b: Functional form optimization per cluster,0
    form_results = optimize_functional_forms(,0
        df_train, psi_col, all_var_names, cat_set, n_cont,,0
        best_result, paths),0
,0
    # Merge SA-optimized forms with post-hoc refinement,0
    # SA already searches forms (search_forms=True in CONFIG); post-hoc refines,0
    best_result["original_fits"] = best_result["fits"],0
    if CONFIG.get("search_forms", False):,0
        sa_forms = best_result.get("best_forms", form_results["best_forms"]),0
        print(f"  SA-optimized forms: {sa_forms}"),0
        print(f"  Post-hoc forms: {form_results['best_forms']}"),0
    best_result["fits"] = form_results["form_fits"],0
    best_result["best_forms"] = form_results["best_forms"],0
,0
    # PART 2: Temporal model comparison,0
    df_cmp, model_summary = run_temporal_comparison(,0
        df_train, psi_col, all_var_names, cat_set, n_cont, best_K,,0
        best_result, paths, df_test=df_test),0
,0
    # PART 3: Diagnostics,0
    diagnostics = run_diagnostics(,0
        df_train, psi_col, all_var_names, cat_set, n_cont, best_K,,0
        best_result, paths),0
,0
    # PART 4: Baseline comparisons,0
    baseline_results = run_baseline_comparisons(,0
        df_train, psi_col, all_var_names, cat_set, n_cont, best_K,,0
        best_result, paths),0
,0
    # PART 5: Stochastic benchmarks,0
    df_stoch, stoch_summary = run_stochastic_benchmarks(,0
        df_train, psi_col, all_var_names, cat_set, n_cont, best_K, paths),0
,0
    # PART 6: Generate plots,0
    generate_all_plots(,0
        per_K_results, bic_by_K, best_K, best_result,,0
        df_train, df_test, psi_col, all_var_names, cat_set, n_cont,,0
        model_summary, diagnostics, paths,,0
        baseline_results=baseline_results, stoch_summary=stoch_summary,,0
        form_results=form_results),0
,0
    # PART 7: Generate LaTeX,0
    generate_latex_results(,0
        per_K_results, bic_by_K, best_K, best_result,,0
        df_train, df_test, psi_col, all_var_names, cat_set, n_cont,,0
        model_summary, diagnostics, paths,,0
        baseline_results=baseline_results, stoch_summary=stoch_summary,,0
        form_results=form_results),0
,0
    # PART 8: Export model coefficients and key details,0
    export_model_coefficients(,0
        per_K_results, best_K, best_result, form_results,,0
        model_summary, all_var_names, paths),0
,0
    # PART 9: Standalone nonlinear form experiment,0
    print(f"\n{'='*60}"),0
    print(f"  PART 9: STANDALONE NONLINEAR FORM EXPERIMENT"),0
    print(f"{'='*60}"),0
    try:,0
        df_nl = run_nonlinear_form_experiment(),0
        if df_nl is not None and len(df_nl) > 0:,0
            nl_out = os.path.join(paths["data_dir"], "nonlinear_standalone_comparison.csv"),0
            df_nl.to_csv(nl_out, index=False),0
            print(f"  Nonlinear standalone results saved to: {nl_out}"),0
    except Exception as e:,0
        print(f"  WARNING: Standalone nonlinear experiment failed: {e}"),0
        print(f"  (This does not affect the main pipeline results)"),0
,0
    # PART 10: MetaCountRegressor mixed models (SparseEA-AGDS selected),0
    #   - SparseEA-AGDS variable selection (see zeke_pavement_metacount.py),0
    #   - Fixed-effects NB on AGDS-selected variables,0
    #   - Random parameters NB  (independent draws per variable),0
    #   - Correlated random parameters NB  (Cholesky covariance),0
    #   - PART 10b: per-cluster random-parameter models (mu_qk, sigma_qk),0
    #   - PART 10c: GSE model (random-parameter means ~ cluster membership),0
    mcr_summary: dict = {},0
    if _HAS_METACOUNT_MODULE:,0
        try:,0
            _mcr_cfg = dict(MCR_CONFIG),0
            # SparseEA-AGDS selection ON by default (disable via MCR_CONFIG).,0
            _mcr_cfg.setdefault("use_agds_selection", True),0
            if quick_mode:,0
                _mcr_cfg["R"] = 50                              # fewer draws in quick mode,0
                _mcr_cfg["rdm_distributions"]     = ["normal"]  # only normal dist in quick mode,0
                _mcr_cfg["rdm_cor_distributions"] = ["normal"]  # only normal dist in quick mode,0
                _mcr_cfg["agds_pop"] = min(int(_mcr_cfg.get("agds_pop", 12)), 8),0
                _mcr_cfg["agds_gen"] = min(int(_mcr_cfg.get("agds_gen", 8)), 5),0
                _mcr_cfg["per_cluster_dists"] = ["normal"],0
,0
            # Frozen CLR cluster memberships -> {sample_id: cluster}. Because,0
            # build_segment_lists indexes segments by sample_id directly,0
            # (sample_id == segment index, 1-indexed), best_result["clusters"],0
            # can be read positionally by sample_id.,0
            _cluster_labels = None,0
            try:,0
                _clusters_arr = np.asarray(best_result.get("clusters")),0
                _cluster_labels = {,0
                    int(sid): int(_clusters_arr[int(sid)]),0
                    for sid in df_train["sample_id"].unique(),0
                    if 0 <= int(sid) < len(_clusters_arr),0
                    and _clusters_arr[int(sid)] is not None,0
                    and np.isfinite(float(_clusters_arr[int(sid)])),0
                },0
                print(f"  Passing {len(_cluster_labels)} CLR cluster labels ",0
                      f"(K={best_K}) to per-cluster / GSE metacount models."),0
            except Exception as _cl_exc:,0
                print(f"  WARNING: could not derive cluster labels ({_cl_exc!r}); ",0
                      f"per-cluster/GSE will fall back to membership CSV / skip."),0
,0
            mcr_result = run_metacount_models(,0
                df_train,,0
                output_dir=paths["data_dir"],,0
                config=_mcr_cfg,,0
                print_progress=True,,0
                cluster_labels=_cluster_labels,,0
            ),0
            mcr_summary = mcr_result.get("mcr_summary", {}),0
        except Exception as e:,0
            print(f"  WARNING: MetaCountRegressor Part 10 failed: {e}"),0
            print(f"  (This does not affect the main pipeline results)"),0
            mcr_summary = {"status": "failed", "reason": str(e)},0
    else:,0
        print(f"\n{'='*60}"),0
        print(f"  PART 10: METACOUNTREGRESSOR MIXED MODELS  [SKIPPED]"),0
        print(f"  Import failed: {_METACOUNT_IMPORT_ERROR}"),0
        print(f"{'='*60}"),0
        mcr_summary = {"status": "skipped", "reason": _METACOUNT_IMPORT_ERROR or "module_not_found"},0
,0
    # PART 11: Markov Decision Process maintenance planning tool,0
    mdp_summary = run_mdp_planning_part(paths),0
,0
    # PART 12: XAI benchmarks + consolidated one-to-one comparison table,0
    #   - re-fits the additive GAM benchmark (xai_benchmark_results.json),0
    #   - consolidates temporal / XAI / interpretable-NN metrics into,0
    #     model_comparison_table.tex (auto-\input by the manuscript),0
    print(f"\n{'='*60}"),0
    print("  PART 12: XAI BENCHMARKS + ONE-TO-ONE COMPARISON TABLE"),0
    print(f"{'='*60}"),0
    try:,0
        import subprocess,0
        here_dir = os.path.dirname(os.path.abspath(__file__)),0
        subprocess.run([sys.executable, os.path.join(here_dir,,0
                       "zeke_xai_benchmarks.py")], check=True),0
        subprocess.run([sys.executable, os.path.join(here_dir,,0
                       "zeke_model_comparison_table.py")], check=True),0
        gen_tex = os.path.join(paths.get("out_dir",,0
                               os.path.join(here_dir, "output_jax")),,0
                               "model_comparison_table.tex"),0
        # copy next to each manuscript so \input resolves on any machine,0
        for paper_sub in ("Pavement", "Pavement_latex"):,0
            dst = os.path.normpath(os.path.join(,0
                here_dir, "..", "..", paper_sub,,0
                "model_comparison_table.tex")),0
            if os.path.exists(gen_tex):,0
                shutil.copyfile(gen_tex, dst),0
                print(f"  refreshed {dst}"),0
    except Exception as e:,0
        print(f"  WARNING: Part 12 failed (does not affect main results): {e}"),0
,0
    # Save full results,0
    full_results = {,0
        "best_K": best_K,,0
        "bic_by_K": {str(k): float(v) for k, v in bic_by_K.items()},,0
        "model_summary": model_summary,,0
        "temporal_codes": [int(c) for c in np.asarray(,0
            best_result.get("temporal_codes", []))],,0
        "temporal_names": [TEMPORAL_CODES.get(int(c), str(c)) for c in np.asarray(,0
            best_result.get("temporal_codes", []))] if _HAS_TEMPORAL_SEARCH else [],,0
        "temporal_search": bool(best_result.get("temporal_search", False)),,0
        "form_summary": form_results["form_summary"],,0
        "best_forms": {str(ci): FORM_NAMES[int(f)] for ci, f in enumerate(form_results["best_forms"])},,0
        "stochastic_summary": stoch_summary,,0
        "baseline_summary": {,0
            "kmeans_r2": baseline_results.get("kmeans_summary", {}).get("r2", 0.0) if baseline_results else 0.0,,0
            "sse_r2": baseline_results.get("sse_summary", {}).get("r2", 0.0) if baseline_results else 0.0,,0
        } if baseline_results else {},,0
        "dw_mean": diagnostics["dw_summary"]["overall_mean_DW"],,0
        "dw_pct_autocorr": diagnostics["dw_summary"]["pct_autocorrelated"],,0
        "ar1_rho_mean": diagnostics["ar1_summary"]["overall_mean_rho"],,0
        "n_segments": int(df_train["sample_id"].nunique()),,0
        "n_observations": len(df_train),,0
        "wall_time_s": time.time() - t_start,,0
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),,0
        "quick_mode": quick_mode,,0
        "figs_only": figs_only,,0
        "metacount_summary": mcr_summary,,0
        "mdp_summary": {,0
            "status": mdp_summary.get("status", "unknown"),,0
            "optimal": {,0
                "total_cost": mdp_summary.get("optimal", {}).get("total_cost"),,0
                "total_agency_cost": mdp_summary.get("optimal", {}).get("total_agency_cost"),,0
                "total_user_cost": mdp_summary.get("optimal", {}).get("total_user_cost"),,0
                "final_pct_acceptable": mdp_summary.get("optimal", {}).get("final_pct_acceptable"),,0
            },,0
            "dn": {,0
                "total_cost": mdp_summary.get("dn", {}).get("total_cost"),,0
                "final_pct_acceptable": mdp_summary.get("dn", {}).get("final_pct_acceptable"),,0
            },,0
            "age_dependent_improvement": mdp_summary.get(,0
                "age_dependent_improvement",,0
                None),,0
        } if isinstance(mdp_summary, dict) else mdp_summary,,0
    },0
    with open(os.path.join(paths["data_dir"], "pipeline_summary.json"), "w") as f:,0
        json.dump(full_results, f, indent=2, default=str),0
,0
    dt = time.time() - t_start,0
    print(f"\n{'=' * 70}"),0
    print(f"  PIPELINE COMPLETE in {dt:.0f}s ({dt/60:.1f} min)"),0
    print(f"  Optimal K = {best_K}"),0
    print(f"  Results: {paths['results_tex']}"),0
    print(f"  Figures:  {paths['fig_dir']}"),0
    print(f"  Tables:   {paths['table_dir']}"),0
    print(f"{'=' * 70}"),0
,0
    return full_results,0
,0
,0
if __name__ == "__main__":,0
    parser = argparse.ArgumentParser(description="Paper generation pipeline"),0
    parser.add_argument("--quick", action="store_true",,0
